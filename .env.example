# Supabase configuration (Public Anon Read-Only Catalogue)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# (Hệ thống cũng hỗ trợ alias SUPABASE_PUBLISHABLE_KEY thay cho SUPABASE_ANON_KEY)

# Application configuration
APP_ENV=development
PORT=8000

# Ghi chú bảo mật:
# - KHÔNG cấu hình SUPABASE_SERVICE_ROLE_KEY trên server web hoặc file .env của ứng dụng.
# - SUPABASE_SERVICE_ROLE_KEY chỉ được truyền qua biến môi trường dòng lệnh khi chạy script seed danh mục:
#   SUPABASE_SERVICE_ROLE_KEY=... python scripts/seed_catalogue.py --apply
