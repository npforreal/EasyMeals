<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Tuyệt đối không khai báo android.permission.INTERNET -->
    <!-- Ứng dụng hoạt động 100% offline trên thiết bị -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- F2: chỉ dùng cho nhắc việc cục bộ; xin quyền khi người dùng bật nhắc việc.
         Không có quyền mạng nào được thêm. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EasyMeals"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.EasyMeals"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- F2: chỉ nhận alarm nội bộ, không export cho ứng dụng khác. -->
        <receiver
            android:name=".data.notifications.ReminderReceiver"
            android:exported="false" />
    </application>

</manifest>
