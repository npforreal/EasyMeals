{
  "name": "easymeals-mobile",
  "version": "1.4.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "EasyMeals mobile native app wrapper using Capacitor",
  "scripts": {
    "test:js": "node --test tests/js/*.test.js",
    "build:web": "python scripts/build_mobile_web.py",
    "cap:sync": "python scripts/build_mobile_web.py && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "workflow:audit": "python3 scripts/audit_workflow.py",
    "workflow:handoff": "python3 scripts/handoff.py",
    "workflow:archive": "python3 scripts/archive_logs.py"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@playwright/test": "^1.64.1",
    "fake-indexeddb": "^6.2.6"
  }
}
